# Run npm run setup to create root .env.local without overwriting existing settings.
# Local classroom preview only. Open the exact address below (no trailing slash).
TECHCARE_DEV_VERIFY=1
TECHCARE_ORIGIN=http://127.0.0.1:3000
TECHCARE_DATA_DIR=./data
# Local development and production both use MySQL. SQLite is reserved for isolated tests/imports.
TECHCARE_DB_DRIVER=mysql
# Supply a random secret with at least 32 bytes for production JWT signing.
TECHCARE_JWT_SECRET=
# MySQL-compatible database settings. Use a dedicated app account, not a root account.
TECHCARE_DB_HOST=127.0.0.1
TECHCARE_DB_PORT=3306
TECHCARE_DB_NAME=techcare
TECHCARE_DB_USER=root
TECHCARE_DB_PASSWORD=
# Set to 1 for production TLS; local development may use 0.
TECHCARE_DB_SSL=0
# Backblaze B2 S3-compatible private bucket. Production refuses local file storage.
TECHCARE_B2_BUCKET=
TECHCARE_B2_ENDPOINT=
TECHCARE_B2_REGION=
TECHCARE_B2_KEY_ID=
TECHCARE_B2_APPLICATION_KEY=
# Configure an approved SMTP provider for actual email verification.
TECHCARE_SMTP_HOST=
TECHCARE_SMTP_PORT=587
TECHCARE_SMTP_FROM=
TECHCARE_SMTP_USER=
TECHCARE_SMTP_PASSWORD=
# Set to 1 behind an approved HTTPS edge. Never trust arbitrary forwarded headers.
TECHCARE_SECURE_COOKIES=0
# Upload videos only after configuring an installed ffprobe executable.
TECHCARE_FFPROBE=
