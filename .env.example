# Copy to .env.local for a local classroom preview only.
TECHCARE_DEV_VERIFY=1
TECHCARE_ORIGIN=http://localhost:5000
# MySQL connection for the application database (import database.sql first).
TECHCARE_DB_HOST=127.0.0.1
TECHCARE_DB_PORT=3306
TECHCARE_DB_NAME=techcare
TECHCARE_DB_USER=root
TECHCARE_DB_PASSWORD=
TECHCARE_DB_POOL_SIZE=10
# Uploaded media remains on disk unless you replace the storage adapter.
TECHCARE_MEDIA_DIR=./data
# Configure an approved SMTP provider for actual email verification.
TECHCARE_SMTP_HOST=
TECHCARE_SMTP_PORT=587
TECHCARE_SMTP_FROM=
TECHCARE_SMTP_USER=
TECHCARE_SMTP_PASSWORD=
# Optional Google OAuth sign-in. Register this exact callback URI in Google Cloud Console.
TECHCARE_GOOGLE_CLIENT_ID=
TECHCARE_GOOGLE_CLIENT_SECRET=
TECHCARE_GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
# Set to 1 behind an approved HTTPS edge. Never trust arbitrary forwarded headers.
TECHCARE_SECURE_COOKIES=0
# Upload videos only after configuring an installed ffprobe executable.
TECHCARE_FFPROBE=
